# los ítems sueltos son solo para admin; el cliente arma su pedido con el checkout

### iniciar sesión como admin (ejecutar primero)
# @name loginAdmin
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "admin@tienda.com",
  "password": "admin1234"
}

### crear (el precio lo pone el servidor y se recalcula el total del pedido)
POST http://localhost:3000/api/order-items
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "orderId": "674a1b2c3d4e5f6789012346",
  "productId": "674a1b2c3d4e5f6789012349",
  "quantity": 2,
  "unitPrice": 1,
  "subtotal": 1
}

### cantidad inválida
POST http://localhost:3000/api/order-items
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "orderId": "674a1b2c3d4e5f6789012346",
  "productId": "674a1b2c3d4e5f6789012349",
  "quantity": 0
}

### pedido inexistente
POST http://localhost:3000/api/order-items
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: application/json

{
  "orderId": "674a1b2c3d4e5f6789012348",
  "productId": "674a1b2c3d4e5f6789012349",
  "quantity": 1
}

### listar todos
GET http://localhost:3000/api/order-items
Authorization: Bearer {{loginAdmin.response.body.data.token}}

### quitar un ítem (reemplazar el id; el pedido tiene que estar pendiente)
DELETE http://localhost:3000/api/order-items/REEMPLAZAR_ID
Authorization: Bearer {{loginAdmin.response.body.data.token}}
