MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tienda

# opcional: DNS públicos si la red no resuelve mongodb+srv (error querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# secreto para firmar los tokens JWT (generar uno largo y aleatorio, ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# opcional: servidor SMTP para mandar el mail de confirmación del registro (sin esto el link se muestra en la consola)
# SMTP_URL=smtp://usuario:clave@smtp.gmail.com:587
# MAIL_FROM=Tienda <no-reply@tienda.com>
# URL de la tienda que va en el link del mail (por defecto la de Vite en desarrollo)
# APP_URL=http://localhost:5173
