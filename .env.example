MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tienda

# opcional: DNS públicos si la red no resuelve mongodb+srv (error querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# secreto para firmar los tokens JWT (generar uno largo y aleatorio, ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
